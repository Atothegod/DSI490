GEMINI_MODEL=gemini/gemini-3.1-flash-lite
GEMINI_API_KEY=
# Compose sets DATABASE_URL to its PostgreSQL service. Local default is SQLite.
# DATABASE_URL=postgresql://agent:agentpass@localhost:5432/agentdb

# Knowledge Base: เอกสาร status=mock_unreviewed ใช้ได้เฉพาะตอนพัฒนา ห้ามเปิดตอนตอบประชาชนจริง
KB_ALLOW_UNREVIEWED=1
# ต้องกำหนดจากผลรัน kb_eval_questions ค่านี้เป็นค่าชั่วคราว
RAG_THRESHOLD=0.12
# 0 = ไม่เรียก Gemini เรียบเรียงคำตอบ ใช้ข้อความเอกสาร KB ตรงตัวแทน
ENABLE_RESPONSE_GENERATOR=1

# เจ้าหน้าที่หลังบ้านปิดเคสผ่าน POST /cases/{case_id}/close
# AGENT_ADMIN_TOKEN=

# LINE Messaging API (Reply + Push สำหรับข้อความเตือน Draft)
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_HMAC_SECRET=
