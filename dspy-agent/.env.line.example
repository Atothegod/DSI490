# Copy to dspy-agent/.env; fill secrets locally. Do not commit the completed file.
APP_ENV=production
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Generate a separate random value once; keep stable to retain user identity mapping.
LINE_USER_HMAC_SECRET=
AGENT_ADMIN_TOKEN=
LINE_MESSAGE_STYLE=flex
ENABLE_RESPONSE_GENERATOR=1
# Production uses reviewed KB documents only.
KB_ALLOW_UNREVIEWED=0
LOCAL_CHAT_INSPECTOR=0
