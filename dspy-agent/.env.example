GEMINI_MODEL=gemini/gemini-3.1-flash-lite
GEMINI_API_KEY=
# Compose sets DATABASE_URL to its PostgreSQL service. Local default is SQLite.
# DATABASE_URL=postgresql://agent:agentpass@localhost:5432/agentdb
ENABLE_RESPONSE_COMPOSER=1
RAG_THRESHOLD=0.12
CONTEXT_MAX_CHARS=6000
SUMMARY_MESSAGE_THRESHOLD=25
# Draft Agent 1–2 HTTP contract: leave unset to keep events honestly pending.
# AGENT2_HANDOFF_URL=https://your-agent2.example/ingest
# AGENT2_HANDOFF_TOKEN=
# Required for authenticated operations, priority overrides, and contact access.
# AGENT_ADMIN_TOKEN=
# LINE webhook only; no push messages.
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_HMAC_SECRET=
# Pending phone TTL is intentionally unset until policy approval (Design 8.1).
# CONTACT_PENDING_TTL_HOURS=24
